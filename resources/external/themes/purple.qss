/* ApplicationStyle
Name=Purple
Id=purple
Mode=fixed
Palette.Window=#f0f0f0
Palette.WindowText=#000000
Palette.Base=#ffffff
Palette.AlternateBase=#f5f5f5
Palette.Text=#000000
Palette.Button=#f0f0f0
Palette.ButtonText=#000000
Palette.Highlight=#7070c8
Palette.HighlightedText=#ffffff
Palette.Link=#0066cc
Palette.LinkVisited=#551a8b
Palette.ToolTipBase=#ffffdc
Palette.ToolTipText=#000000
Palette.Dark=#a0a0a0
Palette.Mid=#b8b8b8
Palette.Shadow=#707070
Palette.BrightText=#ffffff
*/
/* QuiteRSS Purple Style */

QMenuBar {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
										stop:0 #e0e0ee,
										stop:0.4 #d8d8ee,
										stop:0.5 #ccccee,
										stop:1 #e0e0ee);
	color: #000000;
	padding: 1px;
}

QMenuBar::item {
	padding: 3px 6px;
	background: transparent;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}

QMenuBar::item:selected {
	border: 1px solid #8484cc;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #e9e9ff,
								stop:0.4 #e1e1ee,
								stop:0.5 #d9d9ee,
								stop:1 #e9e9ff);
}

QMenuBar::item:pressed {
	border: 1px solid #3434aa;
	border-bottom: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #7a7acc,
								stop:0.4 #7070c8,
								stop:0.5 #6060c4,
								stop:1 #7a7acc);
	color: white;
}

#feedsView_, #newsCategoriesTree_ {
	background: #F9F9FF;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
	min-height: 20px;
}

#categoriesLabel_, #newsTextTitle_ {
	color: #000000;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f6f6fc, stop:1 #eaeaf6);
}

#stackedWidget_ {
	background: white;
}

#tabBarWidget {
	background: #eaeaf8;
	border-bottom: 1px solid #a0a0cf;
}

#tabBar_ QWidget {
	background: transparent;
}

#tabBar_::tab {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #f6f6fc,
	                            stop:1 #eaeaf8);
	border: 1px solid #a0a0cf;
	border-bottom: 1px solid #a0a0cf;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	padding: 4px 2px 4px 2px;
	margin: 4px -1px 0px 0px;
}

#tabBar_::tab:last {
	margin-right: 0px;
}

#tabBar_::tab:selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #fafaff);
	color: #000000;
	border-top: 2px solid #6c6cc8;
	border-bottom: none;
	padding-bottom: 5px;
	margin-top: 2px;
}

#tabBar_::tab:hover:!selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #f0f0fa);
	color: #000000;
}

#tabBar_ > QToolButton {
	border: 1px solid #a0a0cf;
	border-radius: 3px;
	background: #f6f6fc;
}

#tabBar_ > QToolButton:hover {
	background: #ffffff;
	border-color: #6c6cc8;
}

QToolBar {
	border-style: none;
}

#buttonColumnView {
	border: 1px solid #d5d5d5;
	border-top: none;
	padding: 5px 0px 1px 0px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
}

#buttonColumnView:hover, #buttonColumnView:pressed {
	border-color: #6c6cc8;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f2f2fc, stop:1 #dcdcf5);
}

#progressBar_, #splashProgress {
	border: 1px solid #A5A5A5;
	border-radius: 3px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f4f4f4, stop:1 #e4e4e4);
}

#progressBar_::chunk, #splashProgress::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #7a7acc, stop:1 #5858bc);
	border-radius: 2px;
	width: 1px;
}

QHeaderView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	color: #000000;
}

QHeaderView::section {
	border-right: 1px solid #d5d5d5;
	border-bottom: 1px solid #d5d5d5;
	border-top: none;
	border-left: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	padding: 2px;
	padding-left: 3px;
}

QHeaderView::section:hover {
	border-right: 1px solid #6c6cc8;
	border-bottom: 1px solid #6c6cc8;
	border-top: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f2f2fc, stop:1 #dcdcf5);
}

QHeaderView::down-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #D5D5D5;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f9f9f9,
								stop:0.4 #f1f1f1,
								stop:0.6 #e9e9e9,
								stop:1 #f1f1f1);
}

#webViewProgress_::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f1f1f1,
								stop:0.4 #d9d9d9,
								stop:0.6 #d1d1d1,
								stop:1 #d9d9d9);
	width: 10px;
}

#contentLabel_ {
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
										stop:0.1 #D0D0EE,
										stop:0.5 #BCBCEE,
										stop:0.9 #D0D0EE);
	color: #000000;
}

#categoriesTree {
	padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
	min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
	min-height: 18px;
}

QStatusBar #progressBar_{
	margin-right: 5px;
}

QMainWindow::separator {
	border: none;
}

#infoWidgetFR, #actionsWidgetFR {
	background: white;
}

#notificationWidget {
	border: 1px solid #7070c8;
	border-radius: 8px;
}

#titleNotification {
	border-bottom: 1px solid #ccccee;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#bottomNotification {
	border-top: 1px solid #ccccee;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#feedItemNotification {
	border-bottom: 1px solid #7070c8;
}

#pushButtonNull {
	background: #E8E8E8; 
	border: none; 
	padding: 0px;
}

QScrollBar {
	border: none;
	margin: 0px;
	padding: 0px;
}

QScrollBar:vertical {
	background: #f1f1f8;
	width: 16px;
}

QScrollBar:horizontal {
	background: #f1f1f8;
	height: 16px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
	background: transparent;
}

QScrollBar::handle:vertical {
	background: #bdbde0;
	border-radius: 5px;
	margin: 2px 3px;
	min-height: 28px;
}

QScrollBar::handle:horizontal {
	background: #bdbde0;
	border-radius: 5px;
	margin: 3px 2px;
	min-width: 28px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
	background: #9696cf;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
	background: #6c6cc8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	border: none;
	background: none;
	height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	border: none;
	background: none;
	width: 0px;
}