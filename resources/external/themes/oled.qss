/* ApplicationStyle
Name=OLED
Id=oled
Mode=fixed
Palette.Window=#000000
Palette.WindowText=#e8e8e8
Palette.Base=#000000
Palette.AlternateBase=#101010
Palette.Text=#e8e8e8
Palette.Button=#151515
Palette.ButtonText=#e8e8e8
Palette.Highlight=#242424
Palette.HighlightedText=#f8fd99
Palette.Link=#58a6ff
Palette.LinkVisited=#c58af9
Palette.ToolTipBase=#202020
Palette.ToolTipText=#f0f0f0
Palette.Dark=#555555
Palette.Mid=#3a393a
Palette.Shadow=#202020
Palette.BrightText=#ffffff
*/
/* NotQuiteRSS OLED Style */


QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #141414, stop:1 #080808);
    border-bottom: 1px solid #2e2e2e;
    color: #e1e0e1;
    padding: 1px;
}

QMenuBar::item {
    padding: 3px 6px;
    background: transparent;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #262626, stop:1 #181818);
}

QMenuBar::item:pressed {
    background: #2a82da;
    color: #ffffff;
}

QMenu, #AboutDialog QTextEdit {
    border: 1px solid palette(dark);
}

#feedsView_, #newsCategoriesTree_ {
    background: #000000;
    color: #e1e0e1;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
    min-height: 20px;
}
#feedsView_::item:selected, #newsView_::item:selected, #newsCategoriesTree_::item:selected {
    background-color: #242424;
    color: #F8FD99;
}


#categoriesLabel_, #newsTextTitle_ {
    color: #e1e0e1;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #141414, stop:1 #060606);
}

#stackedWidget_ {
    background: #000000;
}

QTabWidget::pane {
    border: 1px solid #2e2e2e;
}

QTabWidget::tab-bar {
    bottom: -1px;
}

QTabBar::tab, #tabBar_::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #141414,
                                stop:1 #0a0a0a);
    border: 1px solid #2e2e2e;
    border-bottom: 1px solid #2e2e2e;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin: 4px -1px 0px 0px;
}

QTabBar::tab {
    padding: 4px 6px;
}

#tabBar_::tab {
    padding: 4px 2px 4px 2px;
}

QTabBar::tab:last, #tabBar_::tab:last {
    margin-right: 0px;
}

QTabBar::tab:selected, #tabBar_::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #161616,
                                stop:0.3 #000000,
                                stop:1 #000000);
    border-top: 2px solid #2a82da;
    border-bottom: none;
    padding-bottom: 5px;
    margin-top: 2px;
}

QTabBar::tab:hover:!selected, #tabBar_::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #202020,
                                stop:1 #141414);
}

QTabBar > QToolButton {
    border: 1px solid #2e2e2e;
    border-radius: 3px;
    background: #101010;
}

QTabBar > QToolButton:hover {
    background: #1c1c1c;
    border-color: #2a82da;
}

QTabBar QWidget {
    background: transparent;
}

#tabBarWidget {
    background: #080808;
    border-bottom: 1px solid #2e2e2e;
}

QToolBar {
    border-style: none;
}

#buttonColumnView {
    border: 1px solid #2e2e2e;
    border-radius: 0px;
    border-top: none;
    border-bottom: none;
    margin-bottom: 1px;
    padding: 5px 0px 2px 0px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161616, stop:1 #0a0a0a);
    min-width: 10px;
}

#buttonColumnView:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #242424, stop:1 #141414);
}

#progressBar_, #splashProgress {
    border: 1px solid #3a393a;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #060606, stop:1 #121212);
}

#progressBar_::chunk, #splashProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3b92ea, stop:1 #2272c8);
    border-radius: 2px;
    width: 1px;
}

QHeaderView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161616, stop:1 #0a0a0a);
    color: #e1e0e1;
}

QHeaderView::section {
    border-right: 1px solid #2e2e2e;
    border-bottom: 1px solid #2e2e2e;
    border-top: none;
    border-left: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161616, stop:1 #0a0a0a);
    /*padding: 2px;*/
    padding-left: 3px;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #242424, stop:1 #141414);
}

QHeaderView::down-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #2e2e2e;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #040404, stop:1 #101010);
	color: #e8e8e8;
}

#webViewProgress_::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #242424, stop:1 #141414);
	width: 10px;
}

#webViewProgressLabel_ {
	color: #e8e8e8;
}

#contentLabel_ {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161616, stop:1 #080808);
    color: #e1e0e1;
}

#categoriesTree {
    padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
    min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
    min-height: 18px;
}

QStatusBar #progressBar_{
    margin-right: 5px;
}

QMainWindow::separator {
    border: none;
}

#infoWidgetFR, #actionsWidgetFR {
    
}

#notificationWidget {
    border: 1px solid #2e2e2e;
    border-radius: 8px;
}

#titleNotification {
    border-bottom: 1px solid #2e2e2e;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#bottomNotification {
    border-top: 1px solid #2e2e2e;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

#feedItemNotification {
    border-bottom: 1px solid #2e2e2e;
}

QLineEdit {
    border: 1px solid #303030;
    background-color: #161616;
    color: #e1e0e1;
    border-radius: 3px;
}

QLineEdit:hover {
    border: 1px solid #484848;
}

QLineEdit:focus {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}

QLineEdit:disabled {
    border: 1px solid #222222;
    background-color: #0e0e0e;
    color: #6e6e6e;
}

#pushButtonNull {
    background: #101010;
    border: none;
    padding: 0px;
    min-width: 6px;
}

QPushButton {
    border: 1px solid #303030;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #222222, stop:1 #161616);
    color: #e1e0e1;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 80px;
}

QPushButton:hover {
    border: 1px solid #484848;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2c2c2c, stop:1 #1e1e1e);
}

QPushButton:pressed, QPushButton:checked {
    border: 1px solid #262626;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #121212, stop:1 #1c1c1c);
}

QPushButton:focus {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}

QPushButton:disabled {
    border: 1px solid #202020;
    background: #101010;
    color: #6e6e6e;
}

#ToolButton {
    border: 1px solid #2e2e2e;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #202020, stop:1 #141414);
    padding: 2px;
    border-radius: 3px;
}

#ToolButton:hover {
    border: 1px solid #2a82da;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2a2a2a, stop:1 #1b1b1b);
    color: #e1e0e1;
}

#ToolButton:pressed, #ToolButton:checked {
    border: 1px solid #2a82da;
    background: #101010;
}

#ToolButton:disabled {
    border: 1px solid #1e1e1e;
    background: #0e0e0e;
    color: #6e6e6e;
}

#ToolButton[popupMode="1"] {
    padding-right: 16px;
}

#ToolButton::menu-button {
    border: none;
    width: 16px;
}

QScrollBar {
    border: none;
    margin: 0px;
    padding: 0px;
}

QScrollBar:vertical {
    background: #0c0c0c;
    width: 16px;
}

QScrollBar:horizontal {
    background: #0c0c0c;
    height: 16px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #484848;
    border-radius: 5px;
    margin: 2px 3px;
    min-height: 28px;
}

QScrollBar::handle:horizontal {
    background: #484848;
    border-radius: 5px;
    margin: 3px 2px;
    min-width: 28px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #686868;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
    background: #848484;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

QGroupBox {
    border: 1px solid #2e2e2e;
    border-radius: 4px;
    margin-top: 2ex;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 5px;
    padding-left: 3px;
}

QComboBox {
    border: 1px solid #303030;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #222222, stop:1 #161616);
    color: #e1e0e1;
    border-radius: 3px;
    padding: 2px 4px;
    min-width: 2em;
}

QComboBox:hover {
    border: 1px solid #484848;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2b2b2b, stop:1 #1d1d1d);
}

QComboBox:focus, QComboBox:on {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}

QComboBox:disabled {
    border: 1px solid #202020;
    background: #101010;
    color: #6e6e6e;
}

QComboBox::drop-down {
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
}

QComboBox::down-arrow {
    image: url(:/images/images/bullet_down.png);
}

QComboBox::down-arrow:on {
    top: 1px;
    left: 1px;
}
