/* ApplicationStyle
Name=Dark
Id=dark
Mode=fixed
Palette.Window=#464546
Palette.WindowText=#e1e0e1
Palette.Base=#464546
Palette.AlternateBase=#3a393a
Palette.Text=#e1e0e1
Palette.Button=#3a393a
Palette.ButtonText=#e1e0e1
Palette.Highlight=#3a393b
Palette.HighlightedText=#f8fd99
Palette.Link=#58a6ff
Palette.LinkVisited=#c58af9
Palette.ToolTipBase=#555555
Palette.ToolTipText=#e1e0e1
Palette.Dark=#666666
Palette.Mid=#555555
Palette.Shadow=#202020
Palette.BrightText=#ffffff
*/
/* QuiteRSS Dark Style */


QMenuBar {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #434243, stop:1 #363536);
	border-bottom: 1px solid #555555;
	color: #e1e0e1;
	padding: 1px;
}

QMenuBar::item {
	padding: 3px 6px;
	background: transparent;
	border-radius: 3px;
}

QMenuBar::item:selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #555555, stop:1 #474647);
}

QMenuBar::item:pressed {
	background: #2a82da;
	color: #ffffff;
}

#feedsView_, #newsCategoriesTree_ {
	background: #464546;
	color: #e1e0e1;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
	min-height: 20px;
}
#feedsView_::item:selected, #newsView_::item:selected, #newsCategoriesTree_::item:selected {
	background-color: #3A393B;
	color: #F8FD99;
}


#categoriesLabel_, #newsTextTitle_ {
	color: #e1e0e1;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #4b4a4c, stop:1 #3e3d3f);
}

#stackedWidget_ {
	background: #464546;
}

QTabWidget::pane {
	border: 1px solid #5c5b5c;
}

QTabWidget::tab-bar {
	bottom: -1px;
}

QTabBar::tab, #tabBar_::tab {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #403f40,
	                            stop:1 #363536);
	border: 1px solid #5c5b5c;
	border-bottom: 1px solid #5c5b5c;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	margin: 4px -1px 0px 0px;
}

QTabBar::tab {
	padding: 4px 6px;
}

#tabBar_::tab {
	padding: 4px 2px 4px 2px;
}

QTabBar::tab:last, #tabBar_::tab:last {
	margin-right: 0px;
}

QTabBar::tab:selected, #tabBar_::tab:selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #525152,
	                            stop:0.25 #464546,
	                            stop:1 #464546);
	border-top: 2px solid #2a82da;
	border-bottom: none;
	padding-bottom: 5px;
	margin-top: 2px;
}

QTabBar::tab:hover:!selected, #tabBar_::tab:hover:!selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #4d4c4d,
	                            stop:1 #403f40);
}

QTabBar > QToolButton {
	border: 1px solid #5c5b5c;
	border-radius: 3px;
	background: #3a393a;
}

QTabBar > QToolButton:hover {
	background: #4d4c4d;
	border-color: #2a82da;
}

QTabBar QWidget {
	background: transparent;
}

#tabBarWidget {
	background: #363536;
	border-bottom: 1px solid #5c5b5c;
}

QToolBar {
	border-style: none;
}

#buttonColumnView {
	border: 1px solid #555555;
	border-radius: 0px;
	border-top: none;
	border-bottom: none;
	margin-bottom: 1px;
	padding: 5px 0px 2px 0px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #454446, stop:1 #373638);
	min-width: 10px;
}

#buttonColumnView:hover {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #525153, stop:1 #424143);
}

#progressBar_, #splashProgress {
	border: 1px solid #555555;
	border-radius: 3px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #3a393b, stop:1 #464547);
}

#progressBar_::chunk, #splashProgress::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #3b92ea, stop:1 #2272c8);
	border-radius: 2px;
	width: 1px;
}

QHeaderView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #454446, stop:1 #373638);
	color: #e1e0e1;
}

QHeaderView::section {
	border-right: 1px solid #555555;
	border-bottom: 1px solid #555555;
	border-top: none;
	border-left: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #454446, stop:1 #373638);
	/*padding: 2px;*/
	padding-left: 3px;
}

QHeaderView::section:hover {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #525153, stop:1 #424143);
}

QHeaderView::down-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #555555;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #3e3d3f, stop:1 #464547);
	color: #e1e0e1;
}

#webViewProgress_::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #535254, stop:1 #424143);
	width: 10px;
}

#webViewProgressLabel_ {
	color: #e1e0e1;
}

#contentLabel_ {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #4d4c4e, stop:1 #3f3e40);
	color: #e1e0e1;
}

#categoriesTree {
	padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
	min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
	min-height: 18px;
}

QStatusBar #progressBar_{
	margin-right: 5px;
}

QMainWindow::separator {
	border: none;
}

#infoWidgetFR, #actionsWidgetFR {
	
}

#notificationWidget {
	border: 1px solid #555555;
	border-radius: 8px;
}

#titleNotification {
	border-bottom: 1px solid #555555;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#bottomNotification {
	border-top: 1px solid #555555;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#feedItemNotification {
	border-bottom: 1px solid #555555;
}

QLineEdit {
	border: 1px solid #5c5b5d;
	background-color: #3c3b3d;
	color: #e1e0e1;
	border-radius: 3px;
}

QLineEdit:hover {
	border: 1px solid #727173;
}

QLineEdit:focus {
	border: 1px solid #2a82da;
	color: #e1e0e1;
}

QLineEdit:disabled {
	border: 1px solid #484749;
	background-color: #3a393a;
	color: #8c8b8d;
}

#pushButtonNull {
	background: #3a393a;
	border: none;
	padding: 0px;
	min-width: 6px;
}

QPushButton {
	border: 1px solid #5d5c5e;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #5a595b, stop:1 #4c4b4d);
	color: #e1e0e1;
	padding: 4px 8px;
	border-radius: 3px;
	min-width: 80px;
}

QPushButton:hover {
	border: 1px solid #727173;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #656466, stop:1 #565557);
}

QPushButton:pressed, QPushButton:checked {
	border: 1px solid #525153;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #444345, stop:1 #4f4e50);
}

QPushButton:focus {
	border: 1px solid #2a82da;
	color: #e1e0e1;
}

QPushButton:disabled {
	border: 1px solid #464546;
	background: #3f3e40;
	color: #8c8b8d;
}

#ToolButton {
	border: 1px solid #585759;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #565557, stop:1 #4a494b);
	padding: 2px;
	border-radius: 3px;
}

#ToolButton:hover {
	border: 1px solid #2a82da;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #626163, stop:1 #535254);
	color: #e1e0e1;
}

#ToolButton:pressed, #ToolButton:checked {
	border: 1px solid #2a82da;
	background: #414042;
}

#ToolButton:disabled {
	border: 1px solid #444345;
	background: #3c3b3d;
	color: #8c8b8d;
}

#ToolButton[popupMode="1"] {
	padding-right: 16px;
}

#ToolButton::menu-button {
	border: none;
	width: 16px;
}

QScrollBar {
	border: none;
	margin: 0px;
	padding: 0px;
}

QScrollBar:vertical {
	background: #3a393a;
	width: 16px;
}

QScrollBar:horizontal {
	background: #3a393a;
	height: 16px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
	background: transparent;
}

QScrollBar::handle:vertical {
	background: #646365;
	border-radius: 5px;
	margin: 2px 3px;
	min-height: 28px;
}

QScrollBar::handle:horizontal {
	background: #646365;
	border-radius: 5px;
	margin: 3px 2px;
	min-width: 28px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
	background: #7b7a7c;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
	background: #8e8d90;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	border: none;
	background: none;
	height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	border: none;
	background: none;
	width: 0px;
}

QGroupBox {
	border: 1px solid #555555;
	border-radius: 4px;
	margin-top: 2ex;
}

QGroupBox::title {
	subcontrol-origin: margin;
	left: 5px;
	padding-left: 3px;
}

QComboBox {
	border: 1px solid #5c5b5d;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #585759, stop:1 #4a494b);
	color: #e1e0e1;
	border-radius: 3px;
	padding: 2px 4px;
	min-width: 2em;
}

QComboBox:hover {
	border: 1px solid #727173;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #626163, stop:1 #535254);
}

QComboBox:focus, QComboBox:on {
	border: 1px solid #2a82da;
	color: #e1e0e1;
}

QComboBox:disabled {
	border: 1px solid #464546;
	background: #3f3e40;
	color: #8c8b8d;
}

QComboBox::drop-down {
	border: none;
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 15px;
}

QComboBox::down-arrow {
	image: url(:/images/images/bullet_down.png);
}

QComboBox::down-arrow:on {
	top: 1px;
	left: 1px;
}
