/* ApplicationStyle
Name=OLED
Id=oledStyle_
Mode=fixed
Palette.Window=#000000
Palette.WindowText=#e8e8e8
Palette.Base=#000000
Palette.AlternateBase=#101010
Palette.Text=#e8e8e8
Palette.Button=#151515
Palette.ButtonText=#e8e8e8
Palette.Highlight=#242424
Palette.HighlightedText=#f8fd99
Palette.Link=#58a6ff
Palette.LinkVisited=#c58af9
Palette.ToolTipBase=#202020
Palette.ToolTipText=#f0f0f0
*/
/* NotQuiteRSS OLED Style */

QWidget {
    background-color: #000000; /* dark */
    alternate-background-color: #101010; /* veryDark */
    color: #e1e0e1; /* veryLight */
    selection-background-color: #242424;
    selection-color: #F8FD99;
}
QWidget:disabled {
    color: gray;
}

QMenuBar {
    background: #101010;
    color: #e1e0e1;
    padding: 1px;
}

QMenuBar::item {
    padding: 3px 6px;
    background: transparent;
}

QMenuBar::item:selected {
    background: #181818;
}

#feedsView_, #newsCategoriesTree_ {
    background: #000000;
    color: #e1e0e1;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
    min-height: 20px;
}
#feedsView_::item:selected, #newsView_::item:selected, #newsCategoriesTree_::item:selected {
    background-color: #242424;
    color: #F8FD99;
}


#categoriesLabel_, #newsTextTitle_ {
    color: #e1e0e1;
}

#feedsPanel_, #categoriesPanel_, #stackedWidget_ {
    background: #000000;
}

QTabWidget::pane {
    border: 1px solid gray;
}

QTabWidget::tab-bar {
    bottom: -1px;
}

QTabBar::tab, #tabBar_::tab {
    background-color: transparent;
    border: 1px solid gray;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin: 0;
    margin-top: 1px;
    margin-right: -1px;
}

QTabBar::tab {
    padding: 4px;
}

#tabBar_::tab {
    padding: 4px 1px 4px 1px;
}

QTabBar::tab:last, #tabBar_::tab:last {
    margin-right: 0px;
}

QTabBar::tab:selected, #tabBar_::tab:selected {
    background: #000000;
    border-bottom: none;
    padding-bottom: 5px;
}

QTabBar::tab:!selected, #tabBar_::tab:!selected {
    background-color: #101010;
    border-bottom: 1px solid gray;
}

QTabBar QToolButton {
    border: 1px solid gray;
    border-radius: 2px;
}

QTabBar QWidget {
    background: none;
}

#tabBarWidget {
    border-bottom: 1px solid gray;
}

QToolBar {
    border-style: none;
}

#buttonColumnView {
    border: 1px solid gray;
    border-radius: 0px;
    border-top: none;
    border-bottom: none;
    margin-bottom: 1px;
    padding: 5px 0px 2px 0px;
    background-color: #101010;
    min-width: 10px;
}

#progressBar_, #splashProgress {
    border: 1px solid #A5A5A5;
    border-radius: 2px;
    background: #000000;
}

#progressBar_::chunk, #splashProgress::chunk {
    background: #2a82da;
    width: 1px;
}

QHeaderView {
    background-color: #101010;
    color: #e1e0e1;
}

QHeaderView::section {
    border-right: 1px solid gray;
    border-bottom: 1px solid gray;
    border-top: none;
    border-left: none;
    background-color: transparent;
    /*padding: 2px;*/
    padding-left: 3px;
}

QHeaderView::down-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #242424;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: #000000;
	color: #e8e8e8;
}

#webViewProgress_::chunk {
	background: #101010;
	width: 10px;
}

#webViewProgressLabel_ {
	color: #e8e8e8;
}

#contentLabel_ {
    background-color: #000000;
    color: #e1e0e1;
}

#categoriesTree {
    padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
    min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
    min-height: 18px;
}

QStatusBar #progressBar_{
    margin-right: 5px;
}

QMainWindow::separator {
    border: none;
}

#infoWidgetFR, #actionsWidgetFR {
    
}

#notificationWidget {
    border: 1px solid gray;
    border-radius: 8px;
}

#titleNotification {
    border-bottom: 1px solid gray;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#bottomNotification {
    border-top: 1px solid gray;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

#feedItemNotification {
    border-bottom: 1px solid gray;
}

QLineEdit {
    border: 1px solid #101010;
    background-color: #181818;
    border-radius: 2px;
}

QLineEdit:focus {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}

#pushButtonNull {
    background: #101010;
    border: none; 
    padding: 0px;
    min-width: 6px;
}

QPushButton {
    border: 1px solid #101010;
    background-color: #181818;
    padding: 4px;
    border-radius: 2px;
    min-width: 80px;
}

QPushButton:focus {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}

#ToolButton {
    border: 1px solid #101010;
    background-color: #181818;
    padding: 2px;
    border-radius: 2px;
}

#ToolButton:hover {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}

#ToolButton[popupMode="1"] {
    padding-right: 16px;
}

#ToolButton::menu-button {
    border: none;
    width: 16px;
}

QScrollBar {
  background: none;
  border: none;
  margin: 0px;
  padding: 0px;
}

QScrollBar:vertical {
  width: 10px;
}

QScrollBar:horizontal {
  height: 10px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal{
  background: #101010;
}

QScrollBar::handle:vertical {
  background: #181818;
  min-height: 20px;
}

QScrollBar::handle:horizontal {
  background: #181818;
  min-width: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0px;
}

QGroupBox {
    border: 1px solid gray;
    margin-top: 2ex;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 5px;
    padding-left: 3px;
}

QComboBox {
    border: 1px solid #101010;
    background-color: #181818;
    border-radius: 2px;
    padding: 2px;
    padding-left: 4px;
    min-width: 2em;
}

QComboBox:on { 
    color: #e1e0e1;
}

QComboBox::drop-down {
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
}

QComboBox::down-arrow {
    image: url(:/images/images/bullet_down.png);
}

QComboBox::down-arrow:on {
    top: 1px;
    left: 1px;
}

QSpinBox {
    border: 1px solid #101010;
    background-color: #181818;
    border-radius: 2px;
    padding: 2px;
    padding-left: 4px;
}

QSpinBox:focus {
    border: 1px solid #2a82da;
    color: #e1e0e1;
}
