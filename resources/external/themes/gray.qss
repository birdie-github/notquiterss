/* ApplicationStyle
Name=Gray
Id=gray
Mode=fixed
Palette.Window=#f0f0f0
Palette.WindowText=#000000
Palette.Base=#ffffff
Palette.AlternateBase=#f5f5f5
Palette.Text=#000000
Palette.Button=#f0f0f0
Palette.ButtonText=#000000
Palette.Highlight=#808080
Palette.HighlightedText=#ffffff
Palette.Link=#0066cc
Palette.LinkVisited=#551a8b
Palette.ToolTipBase=#ffffdc
Palette.ToolTipText=#000000
Palette.Dark=#a0a0a0
Palette.Mid=#b8b8b8
Palette.Shadow=#707070
Palette.BrightText=#ffffff
*/
/* QuiteRSS Gray Style */

QMenuBar {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
										stop:0 #e0e0e0,
										stop:0.4 #d8d8d8,
										stop:0.5 #cccccc,
										stop:1 #e0e0e0);
	color: #000000;
	padding: 1px;
}

QMenuBar::item {
	padding: 3px 6px;
	background: transparent;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}

QMenuBar::item:selected {
	border: 1px solid #848484;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #e9e9e9,
								stop:0.4 #e1e1e1,
								stop:0.5 #d9d9d9,
								stop:1 #e9e9e9);
}

QMenuBar::item:pressed {
	border: 1px solid #545454;
	border-bottom: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #9a9a9a,
								stop:0.4 #909090,
								stop:0.5 #808080,
								stop:1 #9a9a9a);
	color: white;
}

#feedsView_, #newsCategoriesTree_ {
	background: #f9f9f9;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
	min-height: 20px;
}

#categoriesLabel_, #newsTextTitle_ {
	color: #000000;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f7f7f7, stop:1 #ececec);
}

#stackedWidget_ {
	background: white;
}

#tabBarWidget {
	background: #e4e4e4;
	border-bottom: 1px solid #a0a0a0;
}

#tabBar_ QWidget {
	background: transparent;
}

#tabBar_::tab {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #f4f4f4,
	                            stop:1 #e4e4e4);
	border: 1px solid #a0a0a0;
	border-bottom: 1px solid #a0a0a0;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	padding: 4px 2px 4px 2px;
	margin: 4px -1px 0px 0px;
}

#tabBar_::tab:last {
	margin-right: 0px;
}

#tabBar_::tab:selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #f8f8f8);
	color: #000000;
	border-top: 2px solid #808080;
	border-bottom: none;
	padding-bottom: 5px;
	margin-top: 2px;
}

#tabBar_::tab:hover:!selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #eeeeee);
	color: #000000;
}

#tabBar_ > QToolButton {
	border: 1px solid #a0a0a0;
	border-radius: 3px;
	background: #f4f4f4;
}

#tabBar_ > QToolButton:hover {
	background: #ffffff;
	border-color: #808080;
}

QToolBar {
	border-style: none;
}

#buttonColumnView {
	border: 1px solid #d5d5d5;
	border-top: none;
	padding: 5px 0px 1px 0px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
}

#buttonColumnView:hover, #buttonColumnView:pressed {
	border-color: #808080;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f0f0f0, stop:1 #dcdcdc);
}

#progressBar_, #splashProgress {
	border: 1px solid #A5A5A5;
	border-radius: 3px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f4f4f4, stop:1 #e4e4e4);
}

#progressBar_::chunk, #splashProgress::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #9a9a9a, stop:1 #787878);
	border-radius: 2px;
	width: 1px;
}

QHeaderView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	color: #000000;
}

QHeaderView::section {
	border-right: 1px solid #d5d5d5;
	border-bottom: 1px solid #d5d5d5;
	border-top: none;
	border-left: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	padding: 2px;
	padding-left: 3px;
}

QHeaderView::section:hover {
	border-right: 1px solid #808080;
	border-bottom: 1px solid #808080;
	border-top: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f0f0f0, stop:1 #dcdcdc);
}

QHeaderView::down-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #D5D5D5;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f9f9f9,
								stop:0.4 #f1f1f1,
								stop:0.6 #e9e9e9,
								stop:1 #f1f1f1);
}

#webViewProgress_::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f1f1f1,
								stop:0.4 #d9d9d9,
								stop:0.6 #d1d1d1,
								stop:1 #d9d9d9);
	width: 10px;
}

#contentLabel_ {
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
										stop:0.1 #d0d0d0,
										stop:0.5 #BCBCBC,
										stop:0.9 #d0d0d0);
	color: #000000;
}

#categoriesTree {
	padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
	min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
	min-height: 18px;
}

QStatusBar #progressBar_{
	margin-right: 5px;
}

QMainWindow::separator {
	border: none;
}

#infoWidgetFR, #actionsWidgetFR {
	background: white;
}

#notificationWidget {
	border: 1px solid #909090;
	border-radius: 8px;
}

#titleNotification {
	border-bottom: 1px solid #cccccc;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#bottomNotification {
	border-top: 1px solid #cccccc;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#feedItemNotification {
	border-bottom: 1px solid #909090;
}

#pushButtonNull {
	background: #E8E8E8; 
	border: none; 
	padding: 0px;
}