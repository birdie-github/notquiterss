/* ApplicationStyle
Name=Green
Id=green
Mode=fixed
Palette.Window=#f0f0f0
Palette.WindowText=#000000
Palette.Base=#ffffff
Palette.AlternateBase=#f5f5f5
Palette.Text=#000000
Palette.Button=#f0f0f0
Palette.ButtonText=#000000
Palette.Highlight=#70b870
Palette.HighlightedText=#000000
Palette.Link=#0066cc
Palette.LinkVisited=#551a8b
Palette.ToolTipBase=#ffffdc
Palette.ToolTipText=#000000
Palette.Dark=#a0a0a0
Palette.Mid=#b8b8b8
Palette.Shadow=#707070
Palette.BrightText=#ffffff
*/
/* QuiteRSS Green Style */

QMenuBar {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
										stop:0 #e0eee0,
										stop:0.4 #d8eed8,
										stop:0.5 #cceecc,
										stop:1 #e0eee0);
	color: #000000;
	padding: 1px;
}

QMenuBar::item {
	padding: 3px 6px;
	background: transparent;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}

QMenuBar::item:selected {
	border: 1px solid #84cc84;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #e9ffe9,
								stop:0.4 #e1eee1,
								stop:0.5 #d9eed9,
								stop:1 #e9ffe9);
}

QMenuBar::item:pressed {
	border: 1px solid #34aa34;
	border-bottom: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #7acc7a,
								stop:0.4 #70c870,
								stop:0.5 #60c460,
								stop:1 #7acc7a);
	color: white;
}

#feedsView_, #newsCategoriesTree_ {
	background: #F9FFF9;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
	min-height: 20px;
}

#categoriesLabel_, #newsTextTitle_ {
	color: #000000;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f6fbf6, stop:1 #eaf5ea);
}

#stackedWidget_ {
	background: white;
}

#tabBarWidget {
	background: #e4f2e4;
	border-bottom: 1px solid #98c098;
}

#tabBar_ QWidget {
	background: transparent;
}

#tabBar_::tab {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #f5fbf5,
	                            stop:1 #e4f2e4);
	border: 1px solid #98c098;
	border-bottom: 1px solid #98c098;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	padding: 4px 2px 4px 2px;
	margin: 4px -1px 0px 0px;
}

#tabBar_::tab:last {
	margin-right: 0px;
}

#tabBar_::tab:selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #f8fcf8);
	color: #000000;
	border-top: 2px solid #58b858;
	border-bottom: none;
	padding-bottom: 5px;
	margin-top: 2px;
}

#tabBar_::tab:hover:!selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #edf7ed);
	color: #000000;
}

#tabBar_ > QToolButton {
	border: 1px solid #98c098;
	border-radius: 3px;
	background: #f5fbf5;
}

#tabBar_ > QToolButton:hover {
	background: #ffffff;
	border-color: #58b858;
}

QToolBar {
	border-style: none;
}

#buttonColumnView {
	border: 1px solid #d5d5d5;
	border-top: none;
	padding: 5px 0px 1px 0px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
}

#buttonColumnView:hover, #buttonColumnView:pressed {
	border-color: #58b858;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #eef9ee, stop:1 #d7eed7);
}

#progressBar_, #splashProgress {
	border: 1px solid #A5A5A5;
	border-radius: 3px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f4f4f4, stop:1 #e4e4e4);
}

#progressBar_::chunk, #splashProgress::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #7cd87c, stop:1 #54b454);
	border-radius: 2px;
	width: 1px;
}

QHeaderView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	color: #000000;
}

QHeaderView::section {
	border-right: 1px solid #d5d5d5;
	border-bottom: 1px solid #d5d5d5;
	border-top: none;
	border-left: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	padding: 2px;
	padding-left: 3px;
}

QHeaderView::section:hover {
	border-right: 1px solid #58b858;
	border-bottom: 1px solid #58b858;
	border-top: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #eef9ee, stop:1 #d7eed7);
}

QHeaderView::down-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #D5D5D5;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f9f9f9,
								stop:0.4 #f1f1f1,
								stop:0.6 #e9e9e9,
								stop:1 #f1f1f1);
}

#webViewProgress_::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f1f1f1,
								stop:0.4 #d9d9d9,
								stop:0.6 #d1d1d1,
								stop:1 #d9d9d9);
	width: 10px;
}

#contentLabel_ {
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
										stop:0.1 #d8eed8,
										stop:0.5 #B8EEB8,
										stop:0.9 #d8eed8);
	color: #000000;
}

#categoriesTree {
	padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item {
	min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
	min-height: 18px;
}

QStatusBar #progressBar_{
	margin-right: 5px;
}

QMainWindow::separator {
	border: none;
}

#infoWidgetFR, #actionsWidgetFR {
	background: white;
}

#notificationWidget {
	border: 1px solid #70c870;
	border-radius: 8px;
}

#titleNotification {
	border-bottom: 1px solid #cceecc;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#bottomNotification {
	border-top: 1px solid #cceecc;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#feedItemNotification {
	border-bottom: 1px solid #70c870;
}

#pushButtonNull {
	background: #E8E8E8; 
	border: none; 
	padding: 0px;
}

QScrollBar {
	border: none;
	margin: 0px;
	padding: 0px;
}

QScrollBar:vertical {
	background: #f0f6f0;
	width: 16px;
}

QScrollBar:horizontal {
	background: #f0f6f0;
	height: 16px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
	background: transparent;
}

QScrollBar::handle:vertical {
	background: #b8d4b8;
	border-radius: 5px;
	margin: 2px 3px;
	min-height: 28px;
}

QScrollBar::handle:horizontal {
	background: #b8d4b8;
	border-radius: 5px;
	margin: 3px 2px;
	min-width: 28px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
	background: #8dbf8d;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
	background: #58b858;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	border: none;
	background: none;
	height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	border: none;
	background: none;
	width: 0px;
}
