/* ApplicationStyle
Name=Light
Id=light
Mode=fixed
Palette.Window=#f0f0f0
Palette.WindowText=#000000
Palette.Base=#ffffff
Palette.AlternateBase=#f5f5f5
Palette.Text=#000000
Palette.Button=#f0f0f0
Palette.ButtonText=#000000
Palette.Highlight=#0078d4
Palette.HighlightedText=#ffffff
Palette.Link=#0066cc
Palette.LinkVisited=#551a8b
Palette.ToolTipBase=#ffffdc
Palette.ToolTipText=#000000
*/
/* NotQuiteRSS Light Style */

QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5,
                                stop:1 #e8e8e8);
    color: #000000;
    border-bottom: 1px solid #d0d0d0;
    padding: 1px;
}

QMenuBar::item {
    padding: 3px 6px;
    background: transparent;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff,
                                stop:1 #e6f0fa);
    border: 1px solid #a8cbe8;
    color: #000000;
}

QMenuBar::item:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a88dc,
                                stop:1 #006cbe);
    color: #ffffff;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f9f9f9,
                                stop:1 #ececec);
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
    min-height: 20px;
}

#tabBarWidget {
    background: #e8e8e8;
    border-bottom: 1px solid #c0c0c0;
}

#tabBar_ QWidget {
    background: transparent;
}

#newsTextTitle_ {
    color: #000000;
}

#tabBar_::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5,
                                stop:1 #e4e4e4);
    border: 1px solid #c0c0c0;
    border-bottom: 1px solid #c0c0c0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 4px 2px 4px 2px;
    margin: 4px -1px 0px 0px;
}

#tabBar_::tab:last {
    margin-right: 0px;
}

#tabBar_::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff,
                                stop:1 #f8f8f8);
    border-top: 2px solid #0078d4;
    border-bottom: none;
    padding-bottom: 5px;
    margin-top: 2px;
}

#tabBar_::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff,
                                stop:1 #eeeeee);
}

#tabBar_ > QToolButton {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    background: #f5f5f5;
}

#tabBar_ > QToolButton:hover {
    background: #ffffff;
    border-color: #0078d4;
}

QToolBar {
    border-style: none;
}

#buttonColumnView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff,
                                stop:1 #ededed);
    border-left: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    border-top: none;
    border-right: none;
    padding: 4px 0px 2px 0px;
}

#buttonColumnView:hover, #buttonColumnView:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f2f8fd,
                                stop:1 #dcecfb);
    border-bottom: 1px solid #0078d4;
}

#splashProgress {
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec,
                                stop:1 #f6f6f6);
}

#splashProgress::chunk {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2690e0,
                                stop:1 #006cbe);
}

QHeaderView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff,
                                stop:1 #ededed);
    color: #000000;
}

QHeaderView::section {
    background: transparent;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    border-top: none;
    border-left: none;
    padding: 3px 4px;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f2f8fd,
                                stop:1 #dcecfb);
    border-bottom: 1px solid #0078d4;
}

QHeaderView::down-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
    border-top: 1px solid #d0d0d0;
    border-left: none;
    border-right: none;
    border-bottom: none;
    text-align: center;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8f8f8,
                                stop:1 #eaeaea);
}

#webViewProgress_::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2690e0,
                                stop:1 #006cbe);
    width: 10px;
}

#contentLabel_ {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #efefef,
                                stop:0.5 #e3edf7,
                                stop:1 #efefef);
    color: #000000;
}

#categoriesTree {
    padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
    min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
    min-height: 18px;
}

QStatusBar #progressBar_ {
    margin-right: 5px;
}

QMainWindow::separator {
    border: none;
}

#notificationWidget {
    border: 1px solid #c0c0c0;
    border-radius: 8px;
}

#titleNotification {
    border-bottom: 1px solid #dcdcdc;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#bottomNotification {
    border-top: 1px solid #dcdcdc;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

#feedItemNotification {
    border-bottom: 1px solid #c8c8c8;
}

#pushButtonNull {
    border: none;
    padding: 0px;
    min-width: 6px;
}
