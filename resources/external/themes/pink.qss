/* ApplicationStyle
Name=Pink
Id=pink
Mode=fixed
Palette.Window=#f0f0f0
Palette.WindowText=#000000
Palette.Base=#ffffff
Palette.AlternateBase=#f5f5f5
Palette.Text=#000000
Palette.Button=#f0f0f0
Palette.ButtonText=#000000
Palette.Highlight=#cc7070
Palette.HighlightedText=#000000
Palette.Link=#0066cc
Palette.LinkVisited=#551a8b
Palette.ToolTipBase=#ffffdc
Palette.ToolTipText=#000000
Palette.Dark=#a0a0a0
Palette.Mid=#b8b8b8
Palette.Shadow=#707070
Palette.BrightText=#ffffff
*/
/* QuiteRSS Green Style */

QMenuBar {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
										stop:0 #ffe0e0,
										stop:0.4 #ffd8d8,
										stop:0.5 #ffcccc,
										stop:1 #ffe0e0);
	color: #000000;
	padding: 1px;
}

QMenuBar::item {
	padding: 3px 6px;
	background: transparent;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}

QMenuBar::item:selected {
	border: 1px solid #cc8484;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #ffe9e9,
								stop:0.4 #ffe1e1,
								stop:0.5 #ffd9d9,
								stop:1 #ffe9e9);
}

QMenuBar::item:pressed {
	border: 1px solid #aa3434;
	border-bottom: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #ee7a7a,
								stop:0.4 #e87070,
								stop:0.5 #e46060,
								stop:1 #ec7a7a);
	color: white;
}

#feedsView_, #newsCategoriesTree_ {
	background: #FFF9F9;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
	min-height: 20px;
}

#categoriesLabel_, #newsTextTitle_ {
	color: #000000;
}

#feedsPanel_, #categoriesPanel_, #newsPanelWidget_, #buttonPanelWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #fff6f6, stop:1 #f8eaea);
}

#stackedWidget_ {
	background: white;
}

#tabBarWidget {
	background: #fae8e8;
	border-bottom: 1px solid #cfa0a0;
}

#tabBar_ QWidget {
	background: transparent;
}

#tabBar_::tab {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #fff5f5,
	                            stop:1 #fae8e8);
	border: 1px solid #cfa0a0;
	border-bottom: 1px solid #cfa0a0;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	padding: 4px 2px 4px 2px;
	margin: 4px -1px 0px 0px;
}

#tabBar_::tab:last {
	margin-right: 0px;
}

#tabBar_::tab:selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #fffafa);
	color: #000000;
	border-top: 2px solid #cc6666;
	border-bottom: none;
	padding-bottom: 5px;
	margin-top: 2px;
}

#tabBar_::tab:hover:!selected {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
	                            stop:0 #ffffff,
	                            stop:1 #fcefef);
	color: #000000;
}

#tabBar_ > QToolButton {
	border: 1px solid #cfa0a0;
	border-radius: 3px;
	background: #fff5f5;
}

#tabBar_ > QToolButton:hover {
	background: #ffffff;
	border-color: #cc6666;
}

QToolBar {
	border-style: none;
}

#buttonColumnView {
	border: 1px solid #d5d5d5;
	border-top: none;
	padding: 5px 0px 1px 0px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
}

#buttonColumnView:hover, #buttonColumnView:pressed {
	border-color: #cc6666;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #fff0f0, stop:1 #f7d8d8);
}

#progressBar_, #splashProgress {
	border: 1px solid #A5A5A5;
	border-radius: 3px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #f4f4f4, stop:1 #e4e4e4);
}

#progressBar_::chunk, #splashProgress::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ee7a7a, stop:1 #d45454);
	border-radius: 2px;
	width: 1px;
}

QHeaderView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	color: #000000;
}

QHeaderView::section {
	border-right: 1px solid #d5d5d5;
	border-bottom: 1px solid #d5d5d5;
	border-top: none;
	border-left: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #ffffff, stop:1 #f1f2f4);
	padding: 2px;
	padding-left: 3px;
}

QHeaderView::section:hover {
	border-right: 1px solid #cc6666;
	border-bottom: 1px solid #cc6666;
	border-top: none;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 #fff0f0, stop:1 #f7d8d8);
}

QHeaderView::down-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #D5D5D5;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f9f9f9,
								stop:0.4 #f1f1f1,
								stop:0.6 #e9e9e9,
								stop:1 #f1f1f1);
}

#webViewProgress_::chunk {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
								stop:0 #f1f1f1,
								stop:0.4 #d9d9d9,
								stop:0.6 #d1d1d1,
								stop:1 #d9d9d9);
	width: 10px;
}

#contentLabel_ {
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
										stop:0.1 #ffd8d8,
										stop:0.5 #FFBCBC,
										stop:0.9 #ffd8d8);
	color: #000000;
}

#categoriesTree {
	padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
	min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
	min-height: 18px;
}

QStatusBar #progressBar_{
	margin-right: 5px;
}

QMainWindow::separator {
	border: none;
}

#infoWidgetFR, #actionsWidgetFR {
	background: white;
}

#notificationWidget {
	border: 1px solid #e87070;
	border-radius: 8px;
}

#titleNotification {
	border-bottom: 1px solid #ffcccc;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#bottomNotification {
	border-top: 1px solid #ffcccc;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#feedItemNotification {
	border-bottom: 1px solid #e87070;
}

#pushButtonNull {
	background: #E8E8E8; 
	border: none; 
	padding: 0px;
}