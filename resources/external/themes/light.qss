/* ApplicationStyle
Name=Light
Id=lightStyle_
Mode=fixed
Palette.Window=#f0f0f0
Palette.WindowText=#000000
Palette.Base=#ffffff
Palette.AlternateBase=#f5f5f5
Palette.Text=#000000
Palette.Button=#f0f0f0
Palette.ButtonText=#000000
Palette.Highlight=#0078d4
Palette.HighlightedText=#ffffff
Palette.Link=#0066cc
Palette.LinkVisited=#551a8b
Palette.ToolTipBase=#ffffdc
Palette.ToolTipText=#000000
*/
/* NotQuiteRSS Light Style */

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
    min-height: 20px;
}

#tabBar_ QTabWidget::tab-bar {
    bottom: -1px;
}

QToolBar {
    border-style: none;
}

QHeaderView::down-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center top;
    image: url(:/images/images/sortIndicatorA.png);
}

#categoriesTree {
    padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
    min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
    min-height: 18px;
}

QStatusBar #progressBar_ {
    margin-right: 5px;
}

QMainWindow::separator {
    border: none;
}

#pushButtonNull {
    border: none;
    padding: 0px;
    min-width: 6px;
}
